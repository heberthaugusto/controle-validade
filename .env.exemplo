# Copie este arquivo para .env e preencha. O .env nunca deve ir para o Git.

# Planilha de controle (padrão: controle_validade.xlsx na pasta do script)
VALIDADE_XLSX=controle_validade.xlsx
VALIDADE_ABA=Validades
VALIDADE_DIAS_ALERTA=90

# Pasta onde o Lançador procura os .txt do coletor (ex.: \\servidor\coletor)
VALIDADE_PASTA_TXT=

# Lembretes opcionais no corpo do e-mail, separados por ;
VALIDADE_LEMBRETES=Atualizar a planilha após cada recebimento;Conferir fisicamente o lote antes de descartar

# Envio de e-mail (para Gmail, use uma senha de aplicativo, nunca a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
EMAIL_REMETENTE=alertas@exemplo.com.br
EMAIL_SENHA=coloque-aqui-a-senha-de-aplicativo
EMAIL_DESTINO=estoque@exemplo.com.br, compras@exemplo.com.br
